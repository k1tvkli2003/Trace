{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace.local/contracts/structure-proposal-v1.json",
  "title": "structure-proposal-v1",
  "description": "Metadata-only structure candidates. No transcription or lesson text.",
  "type": "object",
  "required": ["schemaVersion", "sourceHash", "pageRefs", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "structure-proposal-v1" },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pageRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "parentId", "order", "kind", "title", "sourceRange", "confidence", "reason", "needsReview"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "parentId": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
          "order": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["part", "chapter", "section", "concept"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sourceRange": {
            "type": "object",
            "required": ["startPage", "endPage"],
            "additionalProperties": false,
            "properties": {
              "startPage": { "type": "integer", "minimum": 1 },
              "endPage": { "type": "integer", "minimum": 1 }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "needsReview": { "type": "boolean" }
        }
      }
    }
  }
}
