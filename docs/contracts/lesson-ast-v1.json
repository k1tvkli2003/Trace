{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace.local/contracts/lesson-ast-v1.json",
  "title": "Trace lesson AST v1 — flat, source-bound draft",
  "description": "Server validates authorized citation IDs and source fidelity separately. Flutter renders validated text and trusted local figure bytes; no raw HTML. Cross-block figure/explanation pairing is enforced by domain validation.",
  "type": "object",
  "required": ["schemaVersion", "sliceId", "language", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "lesson-ast-v1"},
    "sliceId": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "language": {"const": "fa"},
    "blocks": {
      "type": "array", "minItems": 1, "maxItems": 48,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "sourceCitationIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
          "type": {"enum": ["paragraph", "definition_box", "mechanism_box", "tip_box", "warning_box", "comparison_table", "formula_box", "example_box", "figure", "figure_explanation", "key_takeaway", "recall_prompt"]},
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S",
            "not": {"pattern": "<\\s*/?\\s*[a-zA-Z!][^>]*>|\\b[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]\\s*:|\\b[dD][aA][tT][aA]\\s*:"}
          },
          "sourceCitationIds": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
          },
          "figureId": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "figure"}}},
            "then": {"required": ["figureId"], "not": {"required": ["text"]}},
            "else": {"required": ["text"]}
          },
          {
            "if": {"properties": {"type": {"const": "figure_explanation"}}},
            "then": {"required": ["figureId"]}
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": ["paragraph", "definition_box", "mechanism_box", "tip_box", "warning_box", "comparison_table", "formula_box", "example_box", "key_takeaway", "recall_prompt"]
                }
              }
            },
            "then": {"not": {"required": ["figureId"]}}
          }
        ]
      }
    }
  }
}
